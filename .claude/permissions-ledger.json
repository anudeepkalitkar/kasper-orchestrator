  "allow_patterns": [
    {
      "pattern": "\\bgit\\s+push\\b.*\\b(feat|fix|feature)/",
      "note": "feature-branch push — standing exception per git-workflow/boundaries"
    }
  ],
  "ask_patterns": [
    {
      "pattern": "\\brm\\s+-[a-zA-Z]*[rf]",
      "note": "recursive/forced delete — always confirm"
    },
    {
      "pattern": "\\bgit\\s+push\\b.*\\b(main|master|develop|development|qa|prod|production)\\b",
      "note": "shared-branch push is human-only (git-workflow)"
    },
    {
      "pattern": "\\bgit\\s+push\\b.*(\\s-f\\b|--force)",
      "note": "force push — human only"
    },
    {
      "pattern": "\\bgit\\s+reset\\s+--hard\\b",
      "note": "discards local work — confirm"
    },
    {
      "pattern": "\\bgit\\s+clean\\s+-[a-zA-Z]*f",
      "note": "deletes untracked files — confirm"
    },
    {
      "pattern": "\\bgh\\s+pr\\s+merge\\b",
      "note": "merges stay human (git-workflow)"
    },
    {
      "pattern": "\\bgh\\s+repo\\s+(delete|rename)\\b",
      "note": "repo-level mutation — human only"
    },
    {
      "pattern": "\\bgh\\s+api\\b.*(-X|--method)[= ]*(POST|PUT|PATCH|DELETE)",
      "note": "mutating gh api call — network write, confirm (boundaries)"
    },
    {
      "pattern": "\\bsudo\\b",
      "note": "system-level — always confirm"
    },
    {
      "pattern": "\\bchmod\\s+-R\\b|\\bchown\\s+-R\\b",
      "note": "recursive permission change — confirm"
    },
    {
      "pattern": "\\b(curl|wget)\\b",
      "note": "use WebFetch/WebSearch for reads; curl/wget can POST — network write, confirm (boundaries)"
    },
    {
      "pattern": "\\b(dd|mkfs|shred|fdisk)\\b",
      "note": "disk-level destruction — always confirm"
    },
    {
      "pattern": ">\\s*/dev/(?!null|stdout|stderr)",
      "note": "writing to a device — confirm"
    },
    {
      "pattern": "\\bof=/dev/",
      "note": "dd to a device — confirm"
    },
    {
      "pattern": "\\bterraform\\s+(apply|destroy)\\b",
      "note": "cloud mutation, costs money — confirm (boundaries)"
    },
    {
      "pattern": "\\baws\\s+[\\w-]+\\s+(delete|terminate|create|update|put|deploy|run|start|stop|reboot|modify|register|deregister|invoke|cp|sync|mb|rb)[\\w-]*\\b",
      "note": "AWS write — costs money, confirm (boundaries)"
    },
    {
      "pattern": "\\bdocker\\b.*\\b(rm|rmi|prune)\\b",
      "note": "removes containers/images — confirm"
    },
    {
      "pattern": "\\bdocker\\s+compose\\b.*\\bdown\\b.*-v",
      "note": "drops volumes/data — confirm"
    },
    {
      "pattern": ":\\(\\)\\s*\\{[^}]*\\}\\s*;",
      "note": "fork bomb"
    }
  ],
  "grants": [],
  "denials": []
}
